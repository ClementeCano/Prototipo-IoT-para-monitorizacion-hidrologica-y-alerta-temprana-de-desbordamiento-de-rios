# Firebase
FIREBASE_CREDENTIALS=firebase-key.json
# FIREBASE_CREDENTIALS_JSON=
# FIREBASE_CREDENTIALS_JSON_BASE64=

# Alertas
ALERT_TIMEZONE=Europe/Madrid
ALERT_CHECK_SECONDS=5
PUBLIC_BASE_URL=https://dashboard-ebro.fly.dev
SAIH_VERIFY_SSL=1
# auto prueba certifi/sistema y usa fallback sin verificacion si saihebro.com falla por certificados.
SAIH_SSL_MODE=auto

# Correo SMTP
# Para Gmail necesitas activar la verificacion en dos pasos y crear una contrasena de aplicacion.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion
SMTP_FROM=tu_correo@gmail.com
SMTP_STARTTLS=1
SMTP_SSL=0

# Persistencia. En Fly/Render/Railway conviene apuntarlo a un volumen persistente.
# En local puedes dejar DATA_DIR=app; en produccion usa algo como /data.
DATA_DIR=app
USERS_FILE=app/users.json
TOKENS_FILE=app/tokens.json
SESSION_COOKIE_SECURE=0
# En produccion con HTTPS: SESSION_COOKIE_SECURE=1

# PostgreSQL. Si DATABASE_URL existe, USER_STORE_BACKEND=auto usara Postgres.
# En Fly puedes crear/adjuntar Postgres y se definira DATABASE_URL como secret.
USER_STORE_BACKEND=auto
# DATABASE_URL=postgresql://usuario:password@host:5432/base
# Tambien se acepta la configuracion clasica:
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432
MIGRATE_USERS_JSON_ON_START=1
