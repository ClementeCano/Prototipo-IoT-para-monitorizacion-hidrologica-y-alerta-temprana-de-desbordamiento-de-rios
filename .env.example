# Firebase
FIREBASE_CREDENTIALS=firebase-key.json
# FIREBASE_CREDENTIALS_JSON=
# FIREBASE_CREDENTIALS_JSON_BASE64=

# Observabilidad y endpoints internos de depuracion
LOG_LEVEL=INFO
ADMIN_DEBUG=0

# Alertas
ALERT_TIMEZONE=Europe/Madrid
ALERT_CHECK_SECONDS=5
ALERT_STARTUP_DELAY_SECONDS=120
STARTUP_BACKGROUND_DELAY_SECONDS=120
PUBLIC_BASE_URL=https://dashboard-ebro.fly.dev
IA_REFRESH_ON_WS=0
IA_BOOTSTRAP_ON_WS=1
SAIH_VERIFY_SSL=1
# auto prueba certifi/sistema y usa fallback sin verificacion si saihebro.com falla por certificados.
SAIH_SSL_MODE=auto
SAIH_STALE_HOURS=72
SAIH_HTTP_RETRIES=0
SAIH_POLL_SECONDS=180
SAIH_BATCH_SIZE=20
SAIH_BATCH_DELAY_SECONDS=12
SAIH_REQUEST_MAX_SECONDS=15
SAIH_RATE_LIMIT_COOLDOWN_SECONDS=300
SAIH_REFRESH_ON_WS=0
SAIH_SITE_REFRESH_MIN_SECONDS=300
SAIH_ACTUAL_SAMPLE_RETENTION_DAYS=2

# Correo SMTP
# Para Gmail necesitas activar la verificacion en dos pasos y crear una contrasena de aplicacion.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion
SMTP_FROM=tu_correo@gmail.com
SMTP_STARTTLS=1
SMTP_SSL=0

# Persistencia. En Fly/Render/Railway conviene apuntarlo a un volumen persistente.
# En local puedes dejar DATA_DIR=app; en produccion usa algo como /data.
DATA_DIR=app
USERS_FILE=app/users.json
TOKENS_FILE=app/tokens.json
PREDICTIONS_FILE=app/predictions.json
SESSION_COOKIE_SECURE=0
# En produccion con HTTPS: SESSION_COOKIE_SECURE=1

# PostgreSQL. Si DATABASE_URL existe, USER_STORE_BACKEND=auto usara Postgres.
# En Fly puedes crear/adjuntar Postgres y se definira DATABASE_URL como secret.
USER_STORE_BACKEND=auto
PREDICTION_STORE_BACKEND=auto
PREDICTION_EVAL_LOOKBACK_DAYS=30
RELIABILITY_CACHE_SECONDS=3600
PREDICTION_RELIABILITY_PRECACHE=1
PREDICTION_BACKFILL_FROM_FORECAST=0
PREDICTION_EVAL_CHECK_SECONDS=3600
PREDICTION_EVAL_INCLUDE_TODAY=1
PREDICTION_EVAL_MIN_REFRESH_SECONDS=600
PREDICTION_DAILY_REFRESH_ENABLED=1
PREDICTION_DAILY_REFRESH_HOUR=6
PREDICTION_DAILY_REFRESH_MINUTE=0
PREDICTION_DAILY_CHECK_SECONDS=600
PREDICTION_DAILY_STARTUP_GRACE_SECONDS=1800
PREDICTION_USE_LIVE_SAIH=1
PREDICTION_USE_STORED_DAILY=1
PREDICTION_STORED_DAILY_LOOKBACK_DAYS=60
PREDICTION_STORED_DAILY_MIN_DAYS=15
PREDICTION_STORED_DAILY_CACHE_SECONDS=300
PREDICTION_LIVE_SAIH_LOOKBACK_DAYS=21
PREDICTION_LIVE_SAIH_CACHE_SECONDS=1800
PREDICTION_LIVE_SAIH_REQUEST_TIMEOUT_SECONDS=5
PREDICTION_LIVE_SAIH_MAX_SECONDS=25
PREDICTION_MAX_DATASET_STALENESS_DAYS=14
PREDICTION_ALLOW_STALE_DATASET_FALLBACK=0
HISTORY_CACHE_SECONDS=3600
HISTORY_CACHE_MAX_ITEMS=32
HISTORY_CACHE_MAX_BYTES=10485760
# DATABASE_URL=postgresql://usuario:password@host:5432/base
# Tambien se acepta la configuracion clasica:
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432
# DB_SSLMODE=require
MIGRATE_USERS_JSON_ON_START=1
